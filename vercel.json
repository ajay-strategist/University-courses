{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/weekly-summary-cron",
      "schedule": "30 12 * * 6"
    },
    {
      "path": "/api/monthly-summary-cron",
      "schedule": "30 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
